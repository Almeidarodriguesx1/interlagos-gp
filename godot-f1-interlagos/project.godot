; Engine configuration file.
; Configured for Godot 4.4+ on macOS (Apple Metal Forward+ & Jolt Physics 120 Hz).

config_version=5

[application]

config/name="Interlagos GP - F1 Simulator (Godot 4)"
config/description="Simulador de Fórmula 1 em Godot 4.4+ com Jolt Physics 120 Hz, Pacejka, zebras independentes por roda, colisão composta, Pit Lane jogável e pipeline .glb PBR."
run/main_scene="res://scenes/MainRace.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1440
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=1

